{
 "scripts": {
  "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true});\"",
  "db:supabase-sql": "node scripts/print-supabase-category-sql.cjs",
  "ingest:affiliate": "tsx --tsconfig tsconfig.json scripts/affiliate-rest-ingest.ts",
  "ingest:affiliate:dry": "tsx --tsconfig tsconfig.json scripts/affiliate-rest-ingest.ts --dry-run --limit=10 --max-pages=1",
  "ingest:affiliate:dry:fixture": "tsx --tsconfig tsconfig.json scripts/affiliate-rest-ingest.ts --dry-run --fixture=fixtures/affiliate-rest-sample.json --limit=10 --max-pages=1",
  "ingest:dummyjson": "tsx --tsconfig tsconfig.json scripts/dummyjson-ingest.ts",
  "ingest:dummyjson:dry": "tsx --tsconfig tsconfig.json scripts/dummyjson-ingest.ts --dry-run --take=5",
  "demo:reset-deals": "tsx --tsconfig tsconfig.json scripts/reset-and-seed-demo-deals.ts",
  "dev": "next dev",
  "dev:3010": "next dev -p 3010",
  "dev:clean": "npm run clean && next dev",
  "dev:3010:clean": "npm run clean && next dev -p 3010",
  "build": "next build",
  "start": "next start",
  "lint": "next lint",
  "test": "vitest run"
 },
 "dependencies": {
  "@supabase/ssr": "^0.6.1",
  "@supabase/supabase-js": "^2.103.0",
  "@tailwindcss/postcss": "^4.2.2",
  "gray-matter": "^4.0.3",
  "next": "^15.5.15",
  "postcss": "^8.5.9",
  "react": "^19.2.5",
  "react-dom": "^19.2.5",
  "react-markdown": "^10.1.0",
  "remark-gfm": "^4.0.1",
  "server-only": "^0.0.1",
  "tailwindcss": "^4.2.2",
  "zod": "^4.3.6"
 },
 "devDependencies": {
  "@testing-library/dom": "^10.4.1",
  "@testing-library/jest-dom": "^6.9.1",
  "@testing-library/react": "^16.3.2",
  "@types/jsdom": "^28.0.1",
  "@types/react": "^19.2.14",
  "@types/react-dom": "^19.2.3",
  "dotenv": "^16.6.1",
  "jsdom": "^29.0.2",
  "tsx": "^4.20.5",
  "typescript": "^5.9.3",
  "vitest": "^3.2.4"
 }
