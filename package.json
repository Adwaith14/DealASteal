  "@supabase/ssr": "^0.6.1",
  "@supabase/supabase-js": "^2.103.0",
  "@tailwindcss/postcss": "^4.2.2",
  "@upstash/ratelimit": "^2.0.8",
  "@upstash/redis": "^1.37.0",
  "gray-matter": "^4.0.3",
  "next": "^15.5.15",
  "postcss": "^8.5.9",
  "posthog-node": "^5.21.2",
  "react": "^19.2.5",
  "react-dom": "^19.2.5",
  "react-markdown": "^10.1.0",
  "remark-gfm": "^4.0.1",
  "server-only": "^0.0.1",
  "serwist": "^9.5.7",
  "svix": "^1.92.2",
  "tailwindcss": "^4.2.2",
  "web-push": "^3.6.7",
  "zod": "^4.3.6"
 },
